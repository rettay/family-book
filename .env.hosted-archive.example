# Family Book - Hosted Archive Template

FAMILY_BOOK_ENV=production
SECRET_KEY=replace-with-archive-secret
FERNET_KEY=replace-with-archive-fernet-key
BASE_URL=https://archive-slug.family-book.example
TRUSTED_HOSTS=archive-slug.family-book.example
DATABASE_URL=sqlite:////data/family.db
DATA_DIR=/data
ENABLE_API_DOCS=false
DEV_BYPASS_AUTH=false
LOAD_DEMO_DATA=false
LOG_LEVEL=INFO

# Archive owner bootstrap
# ADMIN_EMAILS=owner@example.com
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_FIRST_NAME=Archive
# BOOTSTRAP_ADMIN_LAST_NAME=Owner

# Hosted email identity
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Family Book <invites@archive-slug.family-book.example>

# Hosted passkey origin
# PASSKEY_RP_ID=archive-slug.family-book.example
# PASSKEY_RP_NAME=Family Book
