# Required
SECRET_KEY=          # 64-char hex: python -c "import secrets; print(secrets.token_hex(32))"
FERNET_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BASE_URL=http://localhost:8000
ENABLE_API_DOCS=false
# TRUSTED_HOSTS=localhost,127.0.0.1

# Database
# Use absolute volume-backed paths in Railway/Docker.
# DATABASE_URL=sqlite:////data/family.db
# DATA_DIR=/data
# LOAD_DEMO_DATA=false

# Facebook OAuth (optional — set FB_ENABLED=true to activate)
# FB_ENABLED=false
# FB_APP_ID=
# FB_APP_SECRET=

# Google Sign-In (recommended)
# GOOGLE_CLIENT_ID=
# GOOGLE_HOSTED_DOMAIN=

# Admin emails (comma-separated) — persons with these emails get is_admin=true
# ADMIN_EMAILS=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_FIRST_NAME=Admin
# BOOTSTRAP_ADMIN_LAST_NAME=User

# Approval (if true, invite claims require admin approval)
# REQUIRE_APPROVAL=false

# Magic link email via SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Magic link email via Envelope API (alternative to SMTP)
# ENVELOPE_API_URL=
# ENVELOPE_API_KEY=

# Inbound email webhook
# ENVELOPE_WEBHOOK_SECRET=
# ENVELOPE_ALLOWED_HOSTS=
# ENVELOPE_MAX_ATTACHMENT_BYTES=26214400

# Notifications (all optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=
# WHATSAPP_BUSINESS_TOKEN=
# SIGNAL_BRIDGE_URL=

# Matrix (optional)
# MATRIX_HOMESERVER=http://localhost:6167
# MATRIX_BOT_USER=
# MATRIX_BOT_PASSWORD=
# MATRIX_FAMILY_ROOM=

# Docker Compose image pins (required for compose deployments)
# Use immutable tags or digests, not :latest.
# CONDUIT_IMAGE=
# MAUTRIX_WHATSAPP_IMAGE=
# MAUTRIX_TELEGRAM_IMAGE=
# MAUTRIX_SIGNAL_IMAGE=
# MAUTRIX_META_IMAGE=

# Logging
# LOG_LEVEL=INFO
# PORT=8000
# FAMILY_GRAPH_MAX_DISTANCE=4
# PERSON_CONTACT_MAX_DISTANCE=1
# BACKUP_RETENTION_DAYS=30
