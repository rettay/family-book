# Family Book - Managed Production Archive Example

FAMILY_BOOK_ENV=production
SECRET_KEY=replace-with-64-char-hex-secret
FERNET_KEY=replace-with-valid-fernet-key
BASE_URL=https://family.example.com
TRUSTED_HOSTS=family.example.com
DATABASE_URL=sqlite:////data/family.db
DATA_DIR=/data
ENABLE_API_DOCS=false
DEV_BYPASS_AUTH=false
LOAD_DEMO_DATA=false
LOG_LEVEL=INFO

# Optional but recommended
# ADMIN_EMAILS=steward@example.com
# BOOTSTRAP_ADMIN_EMAIL=steward@example.com

# SMTP for invites and magic links
# SMTP_HOST=your-server.mxrouting.net
# SMTP_PORT=587
# SMTP_USER=invites@family.example.com
# SMTP_PASS=
# SMTP_FROM=Family Book <invites@family.example.com>

# Passkeys / WebAuthn
# PASSKEY_RP_ID=family.example.com
# PASSKEY_RP_NAME=Family Book

# Inbound email
# ENVELOPE_WEBHOOK_SECRET=
# ENVELOPE_API_URL=
# ENVELOPE_ALLOWED_HOSTS=

# Matrix
# MATRIX_HOMESERVER=
# MATRIX_BOT_USER=
# MATRIX_BOT_PASSWORD=
# MATRIX_FAMILY_ROOM=
