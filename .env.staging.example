# Family Book — Staging Environment Variables
# Copy to Railway staging environment dashboard or use railway variables set

SECRET_KEY=change-me-generate-with-python-secrets
FERNET_KEY=change-me-generate-with-cryptography-fernet
FAMILY_BOOK_ENV=staging
BASE_URL=https://family-book-staging.up.railway.app
TRUSTED_HOSTS=family-book-staging.up.railway.app
LOAD_DEMO_DATA=comprehensive
ENABLE_API_DOCS=true
LOG_LEVEL=DEBUG

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Admin bootstrap
ADMIN_EMAILS=your-email@gmail.com

# Optional: Email delivery
# SMTP_HOST=your-server.mxrouting.net
# SMTP_PORT=587
# SMTP_USER=staging@cutroni.xyz
# SMTP_PASS=
# SMTP_FROM=Family Book <staging@cutroni.xyz>

# Optional: Google Maps
# GOOGLE_MAPS_BROWSER_API_KEY=...
# GOOGLE_MAPS_SERVER_API_KEY=...
# GOOGLE_MAPS_MAP_ID=...
